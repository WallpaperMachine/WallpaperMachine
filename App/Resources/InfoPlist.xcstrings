          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engineは、オーディオに反応する壁紙を動かすためにシステムオーディオをキャプチャします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine 需要捕获系统音频来驱动音频响应壁纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallpaper Engine 會擷取系統音訊，以驅動音訊回應桌布。"
          }
        }
      }
